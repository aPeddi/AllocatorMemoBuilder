# ─────────────────────────────────────────────────────────────
# AllocatorMemoBuilder — local config template
# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

AMB_ENV=local
AMB_LOG_LEVEL=info

# ── LLM (Anthropic, direct) ──────────────────────────────────
# With no key the memo falls back to the deterministic offline template.
# The drafting default is the FAST model: the LLM only narrates and every figure
# is re-derived from the engine, so speed wins with no correctness cost. STRONG is
# kept as an override for anyone who wants a heavier draft.
AMB_LLM_PROVIDER=anthropic          # anthropic | openai | none
ANTHROPIC_API_KEY=
AMB_MODEL_FAST=claude-haiku-4-5-20251001
AMB_MODEL_STRONG=claude-sonnet-4-6

# ── Benchmarks & risk-free ───────────────────────────────────
# snapshot = committed as-of fixture (reproducible, default); live = fetch at runtime.
AMB_BENCHMARK_MODE=snapshot
AMB_RISK_FREE_ANNUAL=0.02
# Live benchmark source: auto tries every provider and, when more than one returns
# data, the page lets you choose; fred / yahoo pin exactly one.
AMB_BENCHMARK_PROVIDER=auto        # auto | fred | yahoo

# ── Live market data (FRED + Yahoo) ──────────────────────────
# Both providers are read server-side only by the localhost proxy (serve.py); keys
# are never shipped to the browser. FRED's keyless CSV endpoint and Yahoo's keyless
# chart endpoint both work with no key at all.
# Free FRED key from https://fredaccount.stlouisfed.org/apikey (optional — unlocks the
# keyed FRED API with full history).
FRED_API_KEY=
# Yahoo is keyless by default; set this ONLY if you route Yahoo through a gated
# gateway (e.g. RapidAPI) that requires a key header.
AMB_YAHOO_API_KEY=
AMB_SERVE_HOST=127.0.0.1
AMB_SERVE_PORT=8000

# ── Storage (config seam; not yet wired) ─────────────────────
AMB_DATABASE_URL=sqlite:///./data/local/amb.sqlite
